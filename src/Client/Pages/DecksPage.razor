@page "/decks"
@inject BattleMetricsClientService ClientService

<div class="decks-page">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
        <div style="font-weight: 800; font-size: 1.15rem; color: #F8FAFC;">🃏 Meus Decks & Listas</div>
        <button type="button" class="btn-sync" style="padding: 6px 12px; font-size: 0.85rem;" 
                @onclick="() => showImportModal = !showImportModal">
            @(showImportModal ? "Fechar" : "+ Importar PTCGL")
        </button>
    </div>

    <!-- PTCGL Import Modal / Panel -->
    @if (showImportModal)
    {
        <div class="battle-card" style="border: 2px solid #6366F1;">
            <div class="card-header-title">
                <span>📥 Importador Pokémon TCG Live</span>
            </div>

            <div class="form-group">
                <label class="form-label">Nome do Deck *</label>
                <input type="text" class="form-input" placeholder="ex: Charizard Pidgeot ex" @bind="importDeckName" />
            </div>

            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 10px; margin-bottom: 12px;">
                <div>
                    <label class="form-label">Arquétipo Principal *</label>
                    <input type="text" class="form-input" placeholder="ex: Charizard ex" @bind="importArchetype" />
                </div>
                <div>
                    <label class="form-label">Versão</label>
                    <input type="text" class="form-input" placeholder="v1.0" @bind="importVersion" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Cole a lista de texto do PTCGL *</label>
                <textarea class="form-textarea" rows="6" 
                          placeholder="Cole aqui o texto exportado do Pokémon TCG Live..."
                          @bind="rawListText" @bind:after="OnRawTextChanged"></textarea>
            </div>

            @if (parseResult != null)
            {
                <div style="background: rgba(17, 24, 39, 0.8); border: 1px solid #334155; border-radius: 10px; padding: 12px; margin-bottom: 14px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                        <span style="font-weight: 700; font-size: 0.85rem; color: #CBD5E1;">Contagem de Cartas:</span>
                        <span style="font-weight: 900; font-size: 0.95rem; color: @(parseResult.TotalCards == 60 ? "#34D399" : "#FBBF24");">
                            @(parseResult.TotalCards == 60 ? "✓ 60 Cartas (Padrão Torneio)" : $"⚠️ {parseResult.TotalCards} Cartas")
                        </span>
                    </div>

                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; text-align: center; font-size: 0.8rem; margin-bottom: 8px;">
                        <div style="background: #1E293B; padding: 6px; border-radius: 6px;">
                            <div style="color: #94A3B8; font-size: 0.7rem;">Pokémon</div>
                            <div style="font-weight: 800; color: #60A5FA;">@parseResult.PokemonCount</div>
                        </div>
                        <div style="background: #1E293B; padding: 6px; border-radius: 6px;">
                            <div style="color: #94A3B8; font-size: 0.7rem;">Treinadores</div>
                            <div style="font-weight: 800; color: #C084FC;">@parseResult.TrainerCount</div>
                        </div>
                        <div style="background: #1E293B; padding: 6px; border-radius: 6px;">
                            <div style="color: #94A3B8; font-size: 0.7rem;">Energias</div>
                            <div style="font-weight: 800; color: #FBBF24;">@parseResult.EnergyCount</div>
                        </div>
                    </div>

                    @if (parseResult.SuggestedTechCards.Count > 0)
                    {
                        <div style="margin-top: 10px;">
                            <div style="font-size: 0.75rem; color: #94A3B8; margin-bottom: 4px;">
                                Tech Cards detectadas para telemetria (toque para alternar):
                            </div>
                            <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                                @foreach (var tech in parseResult.SuggestedTechCards)
                                {
                                    var isChecked = selectedTechCards.Contains(tech);
                                    <button type="button" 
                                            class="archetype-chip @(isChecked ? "selected" : "")"
                                            style="padding: 4px 10px; font-size: 0.75rem;"
                                            @onclick="() => ToggleTechCard(tech)">
                                        @(isChecked ? "✓ " : "")@tech
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <button type="button" class="btn-primary-action" 
                    @onclick="SaveImportedDeck" 
                    disabled="@(string.IsNullOrWhiteSpace(importDeckName) || parseResult == null || parseResult.Cards.Count == 0)">
                💾 Salvar e Ativar Deck
            </button>
        </div>
    }

    <!-- Decks List -->
    @if (decks.Count == 0)
    {
        <div class="battle-card" style="text-align: center; padding: 30px; color: #94A3B8;">
            <p>Nenhum deck cadastrado ainda.</p>
            <button type="button" class="btn-sync" style="padding: 8px 16px; font-size: 0.9rem;" 
                    @onclick="() => showImportModal = true">
                + Importar Lista PTCGL
            </button>
        </div>
    }
    else
    {
        @foreach (var d in decks)
        {
            var isActive = d.Id == activeDeckId;
            <div class="battle-card" style="border: @(isActive ? "2px solid #6366F1" : "1px solid var(--border-color)");">
                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 8px;">
                    <div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span style="font-weight: 800; font-size: 1.05rem; color: #F8FAFC;">@d.Name</span>
                            <span style="background: #334155; color: #94A3B8; font-size: 0.7rem; padding: 2px 6px; border-radius: 4px;">
                                @d.Version
                            </span>
                        </div>
                        <div style="font-size: 0.8rem; color: #818CF8; font-weight: 600; margin-top: 2px;">
                            Arquétipo: @d.Archetype
                        </div>
                    </div>

                    @if (isActive)
                    {
                        <span style="background: rgba(99, 102, 241, 0.2); color: #818CF8; border: 1px solid rgba(99, 102, 241, 0.4); font-size: 0.7rem; font-weight: 800; padding: 3px 8px; border-radius: 6px;">
                            ✓ ATIVO NO TORNEIO
                        </span>
                    }
                    else
                    {
                        <button type="button" class="btn-sync" style="background: #1E293B; border: 1px solid #334155;" 
                                @onclick="() => SetActiveDeck(d.Id)">
                            Ativar
                        </button>
                    }
                </div>

                <!-- Card Breakdown -->
                <div style="display: flex; gap: 12px; font-size: 0.75rem; color: #94A3B8; margin-bottom: 10px;">
                    <span>Pokémons: <strong style="color: #60A5FA;">@d.PokemonCount</strong></span>
                    <span>Treinadores: <strong style="color: #C084FC;">@d.TrainerCount</strong></span>
                    <span>Energias: <strong style="color: #FBBF24;">@d.EnergyCount</strong></span>
                    <span>Total: <strong style="color: #F8FAFC;">@d.TotalCards</strong></span>
                </div>

                <!-- Tech Cards -->
                @if (d.TechCards.Count > 0)
                {
                    <div style="border-top: 1px solid #2D3B55; padding-top: 8px;">
                        <div style="font-size: 0.7rem; color: #64748B; font-weight: 600; text-transform: uppercase; margin-bottom: 4px;">
                            Tech Cards Mapeadas (@d.TechCards.Count)
                        </div>
                        <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                            @foreach (var tech in d.TechCards)
                            {
                                <span style="background: rgba(129, 140, 248, 0.15); color: #A5B4FC; font-size: 0.7rem; padding: 2px 8px; border-radius: 4px; border: 1px solid rgba(129, 140, 248, 0.3);">
                                    @tech
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private List<DeckResponse> decks = new();
    private Guid? activeDeckId;
    private bool showImportModal = false;

    private string importDeckName = "";
    private string importArchetype = "";
    private string importVersion = "v1.0";
    private string rawListText = "";
    private PtcglParseResult? parseResult;
    private HashSet<string> selectedTechCards = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDecksAsync();
    }

    private async Task LoadDecksAsync()
    {
        decks = await ClientService.GetDecksAsync();
        activeDeckId = await ClientService.GetActiveDeckIdAsync();
    }

    private void OnRawTextChanged()
    {
        if (!string.IsNullOrWhiteSpace(rawListText))
        {
            parseResult = PtcglDeckParser.Parse(rawListText);
            selectedTechCards = new HashSet<string>(parseResult.SuggestedTechCards);

            if (string.IsNullOrWhiteSpace(importDeckName) && parseResult.Cards.Count > 0)
            {
                // Guess deck name from principal pokemon
                var mainPokemon = parseResult.Cards.FirstOrDefault(c => c.CardType == CardType.Pokemon && c.Quantity >= 2);
                if (mainPokemon != null)
                {
                    importDeckName = $"{mainPokemon.Name} Deck";
                    if (string.IsNullOrWhiteSpace(importArchetype))
                        importArchetype = mainPokemon.Name;
                }
            }
        }
        else
        {
            parseResult = null;
        }
    }

    private void ToggleTechCard(string tech)
    {
        if (selectedTechCards.Contains(tech))
            selectedTechCards.Remove(tech);
        else
            selectedTechCards.Add(tech);
    }

    private async Task SaveImportedDeck()
    {
        if (parseResult == null || string.IsNullOrWhiteSpace(importDeckName)) return;

        var request = new CreateDeckRequest(
            Name: importDeckName.Trim(),
            Archetype: string.IsNullOrWhiteSpace(importArchetype) ? "Geral" : importArchetype.Trim(),
            Version: string.IsNullOrWhiteSpace(importVersion) ? "v1.0" : importVersion.Trim(),
            RawList: rawListText,
            Cards: parseResult.Cards,
            TechCards: selectedTechCards.ToList()
        );

        await ClientService.CreateDeckAsync(request);

        // Reset
        showImportModal = false;
        importDeckName = "";
        importArchetype = "";
        importVersion = "v1.0";
        rawListText = "";
        parseResult = null;
        selectedTechCards.Clear();

        await LoadDecksAsync();
    }

    private async Task SetActiveDeck(Guid deckId)
    {
        await ClientService.SetActiveDeckIdAsync(deckId);
        activeDeckId = deckId;
    }
}
