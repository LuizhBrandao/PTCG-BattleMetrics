<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PTCGBattleMetrics.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PTCGBattleMetrics.Maui.Views"
    Title="PTCG Battle Metrics"
    BackgroundColor="#0B0F19"
    Shell.BackgroundColor="#0B0F19"
    Shell.ForegroundColor="#F8FAFC"
    Shell.TitleColor="#F8FAFC"
    Shell.TabBarBackgroundColor="#151D2F"
    Shell.TabBarForegroundColor="#818CF8"
    Shell.TabBarUnselectedColor="#64748B"
    Shell.TabBarTitleColor="#818CF8">

    <TabBar>
        <Tab Title="Torneio">
            <ShellContent
                Title="Torneio"
                ContentTemplate="{DataTemplate views:FastInputPage}"
                Route="FastInput" />
        </Tab>

        <Tab Title="Métricas">
            <ShellContent
                Title="Métricas"
                ContentTemplate="{DataTemplate views:MatchupMatrixPage}"
                Route="Metrics" />
        </Tab>

        <Tab Title="Decks">
            <ShellContent
                Title="Decks"
                ContentTemplate="{DataTemplate views:DecksPage}"
                Route="Decks" />
        </Tab>

        <Tab Title="Eventos">
            <ShellContent
                Title="Eventos"
                ContentTemplate="{DataTemplate views:TournamentsPage}"
                Route="Tournaments" />
        </Tab>

        <Tab Title="Histórico">
            <ShellContent
                Title="Histórico"
                ContentTemplate="{DataTemplate views:HistoryPage}"
                Route="History" />
        </Tab>

        <Tab Title="Ajustes">
            <ShellContent
                Title="Ajustes"
                ContentTemplate="{DataTemplate views:SettingsPage}"
                Route="Settings" />
        </Tab>
    </TabBar>

</Shell>
