<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PTCGBattleMetrics.Maui.ViewModels"
             xmlns:dto="clr-namespace:PTCGBattleMetrics.Application.DTOs;assembly=PTCGBattleMetrics.Application"
             x:Class="PTCGBattleMetrics.Maui.Views.DecksPage"
             x:DataType="vm:DecksViewModel"
             Title="🃏 Decks"
             BackgroundColor="#0B0F19">

    <ScrollView>
        <VerticalStackLayout Spacing="14" Padding="16,12,16,24" MaximumWidthRequest="700">

            <!-- Cabeçalho e Ação de Importação -->
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="MEUS DECKS" FontSize="16" FontAttributes="Bold" TextColor="#F8FAFC" />
                    <Label Text="Gerencie seus decks e listas PTCGL" FontSize="12" TextColor="#94A3B8" />
                </VerticalStackLayout>
                
                <Button Grid.Column="1"
                        Text="+ Importar PTCGL"
                        FontSize="12"
                        FontAttributes="Bold"
                        HeightRequest="42"
                        CornerRadius="10"
                        BackgroundColor="#4F46E5"
                        TextColor="#F8FAFC"
                        Command="{Binding ToggleImportModalCommand}" />
            </Grid>

            <!-- Painel de Importação PTCGL (Modal / Expansível) -->
            <Border IsVisible="{Binding ShowImportModal}"
                    Stroke="#4F46E5" StrokeThickness="1" BackgroundColor="#151D2F"
                    StrokeShape="RoundRectangle 14" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="📥 Importador de Lista PTCGL" FontSize="14" FontAttributes="Bold" TextColor="#818CF8" Grid.Column="0" />
                        <Button Text="✕" FontSize="12" HeightRequest="32" WidthRequest="32" BackgroundColor="Transparent" TextColor="#94A3B8" Command="{Binding ToggleImportModalCommand}" Grid.Column="1" />
                    </Grid>

                    <Label Text="Cole o texto exportado do Pokémon TCG Live:" FontSize="12" TextColor="#94A3B8" />
                    <Border Stroke="#334155" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 10" Padding="10">
                        <Editor Text="{Binding RawListText}"
                                HeightRequest="120"
                                Placeholder="Pokémon: 14&#10;4 Charmander MEW 4&#10;Trainer: 34&#10;4 Arven OBF 186..."
                                TextColor="#F8FAFC"
                                BackgroundColor="Transparent" />
                    </Border>

                    <Button Text="🔍 Analisar Lista"
                            FontSize="13"
                            FontAttributes="Bold"
                            HeightRequest="40"
                            CornerRadius="8"
                            BackgroundColor="#1E1B4B"
                            TextColor="#818CF8"
                            BorderColor="#4F46E5"
                            BorderWidth="1"
                            Command="{Binding ParseListCommand}" />

                    <!-- Status do Parse -->
                    <Border Stroke="#334155" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 10" Padding="12"
                            IsVisible="{Binding HasParsedList}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="{Binding ParseResult.TotalCount, StringFormat='Total de Cartas: {0}/60'}" FontSize="13" FontAttributes="Bold" TextColor="#34D399" Grid.Column="0" />
                                <Label Text="Válido" FontSize="11" FontAttributes="Bold" TextColor="#34D399" Grid.Column="1" />
                            </Grid>

                            <Label Text="Nome do Deck *" FontSize="12" TextColor="#94A3B8" />
                            <Border Stroke="#334155" BackgroundColor="#151D2F" StrokeShape="RoundRectangle 8" Padding="10,0">
                                <Entry Text="{Binding ImportDeckName.Value}" Placeholder="ex: Charizard ex Pidgeot" TextColor="#F8FAFC" HeightRequest="40" />
                            </Border>

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="Arquétipo" FontSize="11" TextColor="#94A3B8" />
                                    <Entry Text="{Binding ImportArchetype}" Placeholder="ex: Charizard ex" TextColor="#F8FAFC" BackgroundColor="#151D2F" HeightRequest="40" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Versão" FontSize="11" TextColor="#94A3B8" />
                                    <Entry Text="{Binding ImportVersion}" Placeholder="v1.0" TextColor="#F8FAFC" BackgroundColor="#151D2F" HeightRequest="40" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Tech Cards Detectadas -->
                            <Label Text="Cartas Técnicas Detectadas (Tech Cards):" FontSize="11" TextColor="#94A3B8" Margin="0,4,0,0" />
                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                <HorizontalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding SuggestedTechCards}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Button Text="{Binding}"
                                                    FontSize="11"
                                                    CornerRadius="14"
                                                    HeightRequest="32"
                                                    Padding="10,0"
                                                    BackgroundColor="#151D2F"
                                                    TextColor="#818CF8"
                                                    BorderColor="#4F46E5"
                                                    BorderWidth="1"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DecksViewModel}}, Path=ToggleTechCardCommand}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </ScrollView>

                            <Button Text="💾 Salvar Deck"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    HeightRequest="46"
                                    CornerRadius="10"
                                    BackgroundColor="#10B981"
                                    TextColor="#022C22"
                                    Margin="0,8,0,0"
                                    Command="{Binding SaveImportedDeckCommand}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Lista de Decks Cadastrados -->
            <CollectionView ItemsSource="{Binding Decks}">
                <CollectionView.EmptyView>
                    <Label Text="Nenhum deck cadastrado. Clique no botão acima para importar sua primeira lista!"
                           TextColor="#64748B" HorizontalTextAlignment="Center" Margin="0,30" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:DeckResponse">
                        <Border Stroke="#2D3B55" StrokeThickness="1" BackgroundColor="#151D2F"
                                StrokeShape="RoundRectangle 12" Padding="14" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="#F8FAFC" />
                                    <Label Text="{Binding Archetype, StringFormat='Arquétipo: {0}'}" FontSize="12" TextColor="#818CF8" />
                                </VerticalStackLayout>

                                <Label Text="{Binding Version}" FontSize="11" FontAttributes="Bold" TextColor="#94A3B8" Grid.Row="0" Grid.Column="1" />

                                <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="10" Margin="0,8,0,0">
                                    <Label Text="{Binding CardCount, StringFormat='{0} cartas'}" FontSize="11" TextColor="#64748B" />
                                    <Label Text="{Binding TechCards.Count, StringFormat='{0} techs'}" FontSize="11" TextColor="#64748B" />
                                </HorizontalStackLayout>

                                <Button Grid.Row="1" Grid.Column="1"
                                        Text="Tornar Ativo"
                                        FontSize="11"
                                        HeightRequest="32"
                                        CornerRadius="8"
                                        BackgroundColor="#1E1B4B"
                                        TextColor="#818CF8"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DecksViewModel}}, Path=SetActiveDeckCommand}"
                                        CommandParameter="{Binding Id}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
