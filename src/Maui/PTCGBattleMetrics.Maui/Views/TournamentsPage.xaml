<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PTCGBattleMetrics.Maui.ViewModels"
             xmlns:dto="clr-namespace:PTCGBattleMetrics.Application.DTOs;assembly=PTCGBattleMetrics.Application"
             x:Class="PTCGBattleMetrics.Maui.Views.TournamentsPage"
             x:DataType="vm:TournamentsViewModel"
             Title="🏆 Torneios"
             BackgroundColor="#0B0F19">

    <ScrollView>
        <VerticalStackLayout Spacing="14" Padding="16,12,16,24" MaximumWidthRequest="700">

            <!-- Cabeçalho -->
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="TORNEIOS &amp; EVENTOS" FontSize="16" FontAttributes="Bold" TextColor="#F8FAFC" />
                    <Label Text="Acompanhe seus torneios e match points" FontSize="12" TextColor="#94A3B8" />
                </VerticalStackLayout>
                
                <Button Grid.Column="1"
                        Text="+ Novo Torneio"
                        FontSize="12"
                        FontAttributes="Bold"
                        HeightRequest="42"
                        CornerRadius="10"
                        BackgroundColor="#4F46E5"
                        TextColor="#F8FAFC"
                        Command="{Binding ToggleCreateModalCommand}" />
            </Grid>

            <!-- Painel Novo Torneio -->
            <Border IsVisible="{Binding ShowCreateModal}"
                    Stroke="#4F46E5" StrokeThickness="1" BackgroundColor="#151D2F"
                    StrokeShape="RoundRectangle 14" Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="🏆 Cadastrar Novo Torneio" FontSize="14" FontAttributes="Bold" TextColor="#818CF8" Grid.Column="0" />
                        <Button Text="✕" FontSize="12" HeightRequest="32" WidthRequest="32" BackgroundColor="Transparent" TextColor="#94A3B8" Command="{Binding ToggleCreateModalCommand}" Grid.Column="1" />
                    </Grid>

                    <Label Text="Nome do Torneio *" FontSize="12" TextColor="#94A3B8" />
                    <Border Stroke="#334155" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 8" Padding="10,0">
                        <Entry Text="{Binding TourneyName.Value}" Placeholder="ex: Cup de Outono - Taverna dos Dragões" TextColor="#F8FAFC" HeightRequest="42" />
                    </Border>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Local / Loja" FontSize="11" TextColor="#94A3B8" />
                            <Border Stroke="#334155" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 8" Padding="10,0">
                                <Entry Text="{Binding Venue}" Placeholder="ex: Epic Game" TextColor="#F8FAFC" HeightRequest="40" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Data" FontSize="11" TextColor="#94A3B8" />
                            <Border Stroke="#334155" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 8" Padding="10,0">
                                <DatePicker Date="{Binding TourneyDate}" TextColor="#F8FAFC" HeightRequest="40" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="Participantes" FontSize="11" TextColor="#94A3B8" />
                            <Border Stroke="#334155" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 8" Padding="8,0">
                                <Entry Text="{Binding TotalParticipants}" Keyboard="Numeric" Placeholder="ex: 32" TextColor="#F8FAFC" HeightRequest="40" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Colocação" FontSize="11" TextColor="#94A3B8" />
                            <Border Stroke="#334155" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 8" Padding="8,0">
                                <Entry Text="{Binding FinalStanding}" Keyboard="Numeric" Placeholder="ex: 1" TextColor="#F8FAFC" HeightRequest="40" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="4">
                            <Label Text="CPs" FontSize="11" TextColor="#94A3B8" />
                            <Border Stroke="#334155" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 8" Padding="8,0">
                                <Entry Text="{Binding ChampionshipPoints}" Keyboard="Numeric" Placeholder="ex: 50" TextColor="#F8FAFC" HeightRequest="40" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Button Text="Salvar Torneio"
                            FontSize="14"
                            FontAttributes="Bold"
                            HeightRequest="46"
                            CornerRadius="10"
                            BackgroundColor="#10B981"
                            TextColor="#022C22"
                            Margin="0,8,0,0"
                            Command="{Binding CreateTournamentCommand}" />
                </VerticalStackLayout>
            </Border>

            <!-- Lista de Torneios -->
            <CollectionView ItemsSource="{Binding Tournaments}">
                <CollectionView.EmptyView>
                    <Label Text="Nenhum torneio cadastrado. Cadastre um novo torneio acima!"
                           TextColor="#64748B" HorizontalTextAlignment="Center" Margin="0,30" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:TournamentResponse">
                        <Border Stroke="#2D3B55" StrokeThickness="1" BackgroundColor="#151D2F"
                                StrokeShape="RoundRectangle 12" Padding="14" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="#F8FAFC" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding StoreOrVenue}" FontSize="12" TextColor="#818CF8" />
                                        <Label Text="{Binding Date, StringFormat='• {0:dd/MM/yyyy}'}" FontSize="12" TextColor="#94A3B8" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Label Text="{Binding RecordDisplay}" FontSize="14" FontAttributes="Bold" TextColor="#34D399" Grid.Row="0" Grid.Column="1" />

                                <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="10" Margin="0,8,0,0">
                                    <Label Text="{Binding MatchPoints, StringFormat='{0} pts'}" FontSize="12" FontAttributes="Bold" TextColor="#FBBF24" />
                                    <Label Text="{Binding TotalMatches, StringFormat='{0} partidas'}" FontSize="11" TextColor="#64748B" />
                                </HorizontalStackLayout>

                                <Button Grid.Row="1" Grid.Column="1"
                                        Text="Tornar Ativo"
                                        FontSize="11"
                                        HeightRequest="32"
                                        CornerRadius="8"
                                        BackgroundColor="#1E1B4B"
                                        TextColor="#818CF8"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TournamentsViewModel}}, Path=SetActiveTournamentCommand}"
                                        CommandParameter="{Binding Id}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
